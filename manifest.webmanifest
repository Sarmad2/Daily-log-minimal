{
  "id": "./",
  "name": "Daily Log",
  "short_name": "Daily Log",
  "description": "Habits and tasks, logged every day. Works offline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0e1815",
  "theme_color": "#0e1815",
  "categories": ["productivity", "lifestyle"],
  "icons": [
    { "src": "icons/icon-192.png",     "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png",     "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today", "url": "./?tab=today", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Stats", "url": "./?tab=stats", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Month", "url": "./?tab=month", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
